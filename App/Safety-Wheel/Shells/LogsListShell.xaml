<UserControl x:Class="CozyTest.ForShellWindow.LogsListShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CozyTest.ForShellWindow"
             mc:Ignorable="d" 
             Height="800" Width="1250" Margin="-20">
    <StackPanel HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Кто (роль): "/>
            <ComboBox ItemsSource="{Binding WhoList}"
                  SelectedItem="{Binding SelectedWho}"
                  Width="150" Margin="5"/>

            <StackPanel Visibility="{Binding SelectWho, Converter={StaticResource RoleLogsConverter}, ConverterParameter='Admin,Curator'}">
                <TextBlock Text="Куратор: "/>
                <ComboBox ItemsSource="{Binding CuratorsList}"
                  SelectedItem="{Binding SelectedCurator}"
                  Width="150" Margin="5"/>
            </StackPanel>

            <StackPanel Visibility="{Binding SelectWho, Converter={StaticResource RoleLogsConverter}, ConverterParameter='Participant'}">
                <TextBlock Text="Тестируемый: "/>
                <ComboBox ItemsSource="{Binding ParticipantsList}"
                  SelectedItem="{Binding SelectedParticipant}"
                  Width="150" Margin="5"/>
            </StackPanel>

            <TextBlock Text="Действие: "/>
            <ComboBox ItemsSource="{Binding LevelLogList}"
                  SelectedItem="{Binding SelectedLevelLog}"
                  Width="150" Margin="5"/>

            <TextBlock Text="С чем/кем:"/>
            <ComboBox ItemsSource="{Binding ObjectList}"
                  SelectedItem="{Binding SelectedObject}"
                  Width="150" Margin="5"/>

            <Button Width="120"
                    Height="50"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0" 
                    Margin="30 0 0 0"
                    Command="{Binding ClearFiltersCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Images/clear_icon.png"
                           Width="40"
                           Height="40"/>
                    <TextBlock Text="Очистить фильтры" 
                               TextWrapping="Wrap" 
                               Width="80" 
                               Margin="10 0 0 0" 
                               TextElement.Foreground="{StaticResource MainSwamp}" 
                               TextElement.FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <DataGrid BorderThickness="3" 
                  BorderBrush="{StaticResource MainSwamp}"
                  ItemsSource="{Binding FilteredLogsList}"
                  SelectedItem="{Binding SelectedLog}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Visible"
                  HeadersVisibility="Column"
                  Height="700"
                  Background="White">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="60"/>
                <DataGridTextColumn Binding="{Binding TimeStamp}" Header="Время" Width="160"/>
                <DataGridTextColumn Binding="{Binding TypeWhoMade}" Header="Роль" Width="100"/>
                <DataGridTextColumn Binding="{Binding WhoMade}" Header="Кто" Width="180"/>
                <DataGridTextColumn Binding="{Binding LevelLog}" Header="Что" Width="100"/>
                <DataGridTextColumn Binding="{Binding TypeObject}" Header="Тип объекта" Width="110"/>
                <DataGridTextColumn Binding="{Binding Object}" Header="С чем/кем" Width="180"/>

                <DataGridTextColumn Binding="{Binding Message}" 
                            Header="Подробнее" 
                            Width="*"
                            ElementStyle="{StaticResource WrapTextStyle}"/>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding WhoMadeCommand}" Header="Все действия пользователя (Кто)"/>
                    <MenuItem Command="{Binding LevelLogCommand}" Header="Все действия (Что)"/>
                    <MenuItem Command="{Binding ObjectCommand}" Header="Все действия над (С чем/кем)"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </StackPanel>
</UserControl>