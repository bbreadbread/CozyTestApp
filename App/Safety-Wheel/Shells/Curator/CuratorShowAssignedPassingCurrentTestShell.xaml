<UserControl x:Class="CozyTest.ForShellWindow.CuratorShowAssignedPassingCurrentTestShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Перейти к прохождениям этого теста" Command="{Binding GoToResultsCommand}"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Группы">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding GroupsList}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="60"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="Название группы" Width="*"/>
                            <DataGridTextColumn Binding="{Binding TotalParticipants}" Header="Всего" Width="80"/>
                            <DataGridTextColumn Binding="{Binding PassedCount}" Header="Прошли" Width="80"/>

                            <DataGridTemplateColumn Header="Прогресс" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" 
                                                         Maximum="100" 
                                                         Height="20"
                                                         Background="#E0E0E0"
                                                         Foreground="{StaticResource MainSwamp}"/>
                                            <TextBlock Text="{Binding ProgressText}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding ProgressPercent, StringFormat={}{0:F0}%}" 
                                                Header="%" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Мои тестируемые">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding ParticipantsList}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="60"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="ФИО" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Login}" Header="Логин" Width="150"/>
                            <DataGridTextColumn Binding="{Binding StatusText}" Header="Статус" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#2000685A" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0" 
                             IsIndeterminate="True" 
                             Foreground="{StaticResource MainSwamp}"
                             Width="50" 
                             Height="50"/>
                <TextBlock Text="Загрузка..." Margin="0 10 0 0" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>