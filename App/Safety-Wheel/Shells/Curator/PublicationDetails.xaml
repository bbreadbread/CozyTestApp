<UserControl x:Class="CozyTest.ForShellWindow.PublicationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CozyTest.ForShellWindow"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 10">
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <CheckBox IsChecked="{Binding IsAllPublic}"
                          Command="{Binding AllBindCommand}"
                          VerticalAlignment="Center"
                          Margin="0 0 10 0"/>
                <TextBlock Text="Опубликовать всем привязанным тестируемым" 
                           FontSize="16" 
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" 
                                     SelectedIndex="{Binding SelectedTabIndex}"
                                     Margin="0 10">

            <TabItem Header="Группы">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid BorderThickness="0" 
                              ItemsSource="{Binding GroupsList}" 
                              SelectedItem="{Binding SelectedGroup}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              MaxHeight="450"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Опубликовать" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPublished, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.SwitchPublisedGroupsCommand, 
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Id}" Header="ID Группы" Width="80"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="Название" Width="*"/>
                            <DataGridTextColumn Binding="{Binding CountPart}" Header="Кол-во участников" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Мои тестируемые">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid VerticalScrollBarVisibility="Auto" 
                              BorderThickness="0" 
                              ItemsSource="{Binding ParticipantsList}" 
                              SelectedItem="{Binding SelectedParticipant}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              MaxHeight="450"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Опубликовать" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPublished, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.SwitchPublisedParticipantCommand, 
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="60"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="ФИО" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Login}" Header="Логин" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="3"
         Background="#2000685A" 
         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"  
                     IsIndeterminate="True" 
                     Foreground="{StaticResource MainSwamp}"
                     Width="50" 
                     Height="50"/>
                <TextBlock Text="Загрузка..." Margin="0 10 0 0" FontSize="16"/>
            </StackPanel>
        </Border>
        
    </Grid>
</UserControl>