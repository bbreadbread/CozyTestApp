<UserControl x:Class="CozyTest.ForShellWindow.AssignedDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CozyTest.ForShellWindow"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:conv="clr-namespace:CozyTest.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Height="700" Width="900">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:DateHasAssignmentConverter x:Key="DateHasAssignmentConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Margin="10">
            <TabItem Header="Календарь назначений">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Calendar Grid.Column="0"
                              Name="AssignmentCalendar"
                              SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                              DisplayDate="{Binding SelectedDate, Mode=TwoWay}"
                              SelectionMode="SingleDate"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Width="210"
                              Height="Auto">
                        <Calendar.CalendarDayButtonStyle>
                            <Style TargetType="CalendarDayButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>

                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource DateHasAssignmentConverter}">
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="DataContext.DatesWithAssignments" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="LightGreen"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Calendar.CalendarDayButtonStyle>
                    </Calendar>

                    <StackPanel Grid.Column="1" VerticalAlignment="Stretch">
                        <GroupBox Header="Назначенные тесты на выбранную дату" Margin="10 0 0 10">
                            <ListView ItemsSource="{Binding TestsOnSelectedDate}"
                                      SelectedItem="{Binding SelectedAssignedTest}"
                                      Height="150"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"  
                                      MinHeight="450">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding TestId}" Width="50"/>
                                        <GridViewColumn Header="Название теста" DisplayMemberBinding="{Binding Test.Name}" Width="250"/>
                                        <GridViewColumn Header="Тестируемый" DisplayMemberBinding="{Binding Participant.Name}" Width="200"/>
                                        <GridViewColumn Header="Назначил" DisplayMemberBinding="{Binding Curator.Name}" Width="150"/>
                                        <GridViewColumn Header="Дата назначения" DisplayMemberBinding="{Binding DateTimeAssigned, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Настройка назначения">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 10">
                        <StackPanel Orientation="Horizontal" Margin="0 5">
                            <CheckBox IsChecked="{Binding IsAssignToAll}"
                                      Command="{Binding AllBindCommand}"
                                      VerticalAlignment="Center"
                                      Margin="0 0 10 0"/>
                            <TextBlock Text="Назначить всем привязанным тестируемым" 
                                       FontSize="16" 
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <DatePicker Grid.Row="1" 
                                SelectedDate="{Binding AssignmentDate}"
                                mah:TextBoxHelper.Watermark="Выберите дату назначения"
                                Margin="0 10"
                                Height="40"/>

                    <TabControl Grid.Row="2" SelectedIndex="{Binding AssignmentTabIndex}" Margin="0 10">
                        <TabItem Header="Группы">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid BorderThickness="0" 
                                          ItemsSource="{Binding GroupsList}" 
                                          SelectedItem="{Binding SelectedGroup}" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          MaxHeight="450"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Назначить" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAssigned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Command="{Binding DataContext.SwitchAssignedGroupsCommand, 
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Id}" Header="ID Группы" Width="80"/>
                                        <DataGridTextColumn Binding="{Binding Name}" Header="Название" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding CountPart}" Header="Кол-во участников" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Мои тестируемые">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid VerticalScrollBarVisibility="Auto" 
                                          BorderThickness="0" 
                                          ItemsSource="{Binding ParticipantsList}" 
                                          SelectedItem="{Binding SelectedParticipant}" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          MaxHeight="450"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Назначить" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAssigned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Command="{Binding DataContext.SwitchAssignedParticipantCommand, 
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="60"/>
                                        <DataGridTextColumn Binding="{Binding Name}" Header="ФИО" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding Login}" Header="Логин" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="2"
                Background="#2000685A" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"  
                             IsIndeterminate="True" 
                             Foreground="{StaticResource MainSwamp}"
                             Width="50" 
                             Height="50"/>
                <TextBlock Text="Загрузка..." Margin="0 10 0 0" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>