<UserControl x:Class="CozyTest.ForShellWindow.CreateEditTopic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CozyTest.ForShellWindow"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:conv="clr-namespace:CozyTest.Converters"
             mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <TextBlock Text="Работа с темами" Margin="20" Grid.ColumnSpan="3" Style="{StaticResource ShellTitle}"/>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Style="{StaticResource TBoxStyle}" 
                     Margin="0 10" 
                     Height="50"
                     mah:TextBoxHelper.Watermark="Поиск темы..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding FilteredTopics}"
                     SelectedItem="{Binding SelectedTopic}"
                     Height="200"
                     Margin="0 10"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" 
                                   FontSize="16"
                                   Padding="10"
                                   Margin="0 2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource LightSwamp}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Удалить тему"
                                              Command="{Binding DataContext.DeleteTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}">
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBox Grid.Row="2" 
                     Margin="0 10" 
                     mah:TextBoxHelper.Watermark="Название темы" 
                     Text="{Binding TopicName, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"/>

            <Border Grid.Row="3" 
                    BorderBrush="{StaticResource DarkSwamp}" 
                    BorderThickness="2" 
                    VerticalAlignment="Top"
                    Margin="0 20 0 0"/>

            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        
                        Margin="0 30" >
                <Button Style="{StaticResource ShellButton}" 
                        Content="Добавить" 
                        FontSize="25" 
                        Width="300"
                        Height="60"
                        Command="{Binding AddTopicCommand}"
                        Margin="10"/>
                <Button Style="{StaticResource ShellButton}" 
                        Content="Обновить" 
                        FontSize="25" 
                        Width="300"
                        Height="60"
                        Command="{Binding UpdateTopicCommand}"
                        IsEnabled="{Binding CanUpdate}"
                        Margin="10"/>
            </StackPanel>
            <Border Grid.RowSpan="6" Grid.Row="0"
                Background="#2000685A" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"  
                             IsIndeterminate="True" 
                             Foreground="{StaticResource MainSwamp}"
                             Width="50" 
                             Height="50"/>
                    <TextBlock Text="Загрузка..." Margin="0 10 0 0" FontSize="16"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>