<UserControl x:Class="CozyTest.ForShellWindow.ShellGradingSystem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CozyTest.ForShellWindow"
      mc:Ignorable="d" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
     HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="BorderBrush" Value="{StaticResource MainSwamp}"/>
                <Setter Property="BorderThickness" Value="0 0 0 2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <CheckBox Grid.Row="0"
                  Content="Нужна система оценивания"
                  VerticalAlignment="Center"
                  FontSize="22"
                  Margin="0 20"
                  IsChecked="{Binding IsGradingEnabled}"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding GradingItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0 15">
                         <TextBlock Text="Все, что ниже: " 
                                   Margin="30 0 0 0"
                                   Visibility="{Binding IsLast, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        
                        <CheckBox VerticalAlignment="Center"
                                  FontSize="20"
                                  IsChecked="{Binding IsActive}"
                                  IsEnabled="{Binding DataContext.IsGradingEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBox Text="{Binding Name}" 
                                 Width="240"
                                 IsEnabled="{Binding IsActive}"/>

                        <TextBlock Text="—" Margin="15 0" 
                                   Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBox Text="{Binding MinPercent}" 
                                 Width="85"
                                 IsEnabled="{Binding IsActive}"
                                 Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBlock Text="%" 
                                   Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" 
                Style="{StaticResource ShellButton}" 
                Content="Сохранить"
                Command="{Binding SaveCommand}"
                Margin="0 20"/>
    </Grid>
</UserControl>