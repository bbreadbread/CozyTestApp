<UserControl x:Class="CozyTest.Pages.Curator.CuratorCreateTestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:CozyTest.ViewModels.CreateTestsVM"
             xmlns:conv="clr-namespace:CozyTest.Converters">

    <UserControl.Resources>
        <conv:IndexPlusOneConverter x:Key="IndexPlusOneConverter"/>
        <conv:NullImageConverter x:Key="NullImageConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <conv:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
        <conv:QuestionTypeVisibilityConverter x:Key="QuestionTypeVisibilityConverter"/>

        <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyToVisible" EmptyValue="Visible" NotEmptyValue="Collapsed"/>
        <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyToCollapsed" EmptyValue="Collapsed" NotEmptyValue="Visible"/>
        <conv:BoolToIntConverter x:Key="BoolToIntConverter"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" 
                                ZeroValue="Visible" 
                                NonZeroValue="Collapsed"/>

        <conv:ZeroToVisibilityConverter x:Key="ZeroToCollapsed" 
                                ZeroValue="Collapsed" 
                                NonZeroValue="Visible"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLength" TrueValue="Auto" FalseValue="0"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Expander BorderBrush="{StaticResource MainSwamp}" BorderThickness="2" Background="{StaticResource LightSwamp}" Foreground="{StaticResource DarkSwamp}" TextElement.FontWeight="SemiBold" IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="Подробности" HorizontalAlignment="Center" FontSize="25"/>
            </Expander.Header>
            <Grid MaxWidth="1450" Margin="0 10 0 10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource UpMenuTest}" Grid.Row="0" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                        </Grid.RowDefinitions>

                        <mah:NumericUpDown Grid.Column="0" 
                                   Margin="1 1 5 2" 
                                   Background="{StaticResource LightSwamp}" 
                                   Value="{Binding TestTimeLimit}"
                                   BorderThickness="0"
                                   mah:TextBoxHelper.Watermark="Секунд"/>
                        <TextBlock Grid.Column="1" 
                           Text="сек." 
                           Grid.RowSpan="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextElement.FontSize="16"
                           TextElement.Foreground="{StaticResource MainSwamp}"/>
                    </Grid>
                </Border>

                <TextBox Grid.Row="0" 
                 Grid.Column="1" 
                 Grid.ColumnSpan="2" 
                 Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{DynamicResource TBoxStyle}" 
                 mah:TextBoxHelper.Watermark="Название теста"
                 Height="45"
                 Margin="15 0 15 0"/>

                <ComboBox Style="{StaticResource UpMenuTestComboBox}"  
                  ItemsSource="{Binding Topics}"
                  SelectedItem="{Binding SelectedTopic}" 
                  DisplayMemberPath="Name"
                  Grid.Row="0" 
                  Grid.Column="3" 
                  mah:TextBoxHelper.Watermark="Тема"
                  Height="45"/>

                <ComboBox Style="{StaticResource UpMenuTestComboBox}" 
                  ItemsSource="{Binding DTestTypes}"
                  SelectedItem="{Binding SelectedDTestType}" 
                  DisplayMemberPath="Name"
                  Grid.Row="0" 
                  Grid.Column="4" 
                  mah:TextBoxHelper.Watermark="Тип"
                  Height="45"
                  Margin="10 0 0 0"/>



                <Border Style="{StaticResource UpMenuTest}" Grid.Row="1" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                        </Grid.RowDefinitions>

                        <mah:NumericUpDown 
                            Minimum="0"
                            Maximum="100"
                            Interval="1"
                            Margin="1 1 0 2" 
                            BorderThickness="0"
                            Background="{StaticResource LightSwamp}" 
                            Value="{Binding TestMaxNumPassing}"/>
                        <TextBlock Grid.Column="1" 
                           Text="попыток" 
                           Grid.RowSpan="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextElement.FontSize="16"
                           TextElement.Foreground="{StaticResource MainSwamp}"/>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1" 
                 Grid.Column="1" 
                 Grid.ColumnSpan="2"
                 Height="45" 
                 Margin="15 0"
                        
                 mah:TextBoxHelper.Watermark="Описание" 
                 Style="{DynamicResource TBoxStyle}" 
                 Background="{StaticResource LightSwamp}" 
                 BorderBrush="{StaticResource MainSwamp}"
                 BorderThickness="3"
                 Text="{Binding TestDescription, UpdateSourceTrigger=PropertyChanged}"/>

                <!--<Button Style="{StaticResource ShellDarkSwampButton}" 
                Grid.Row="1" 
                Grid.Column="3"
                Height="45"
                Margin="0 10 0 0">
                    <Button.Content>
                        <TextBlock TextWrapping="Wrap" 
                           Text="Соавторство" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           TextElement.Foreground="{StaticResource White}"
                           TextElement.FontSize="18"/>
                    </Button.Content>
                </Button>-->

                <Grid Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center">
                    <ToggleButton x:Name="ToggleBtn" Content="Дополнительно" 
                  Height="45" Width="250"/>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ToggleBtn}"
           PlacementTarget="{Binding ElementName=ToggleBtn}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" 
                Padding="10">
                            <StackPanel Orientation="Vertical">
                                <CheckBox Content="Размешать вопросы" 
                          IsChecked="{Binding TestIsRandom, 
                          UpdateSourceTrigger=PropertyChanged}"/>
                                <Separator Margin="5"/>
                                <CheckBox Content="Сразу показать результат" 
                          IsChecked="{Binding TestIsShowNowAnswer, 
                          UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
            </Grid>


            <Button Style="{StaticResource ShellDarkSwampButton}" 
                Grid.Row="1" 
                Grid.Column="3"
                Height="45"
                Margin="10 10 0 0" 
                Command="{Binding GoGradingSystemCommand}">
                    <Button.Content>
                        <TextBlock TextWrapping="Wrap" 
                           Text="Система оценивания" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           TextElement.Foreground="{StaticResource White}"
                           TextElement.FontSize="18"/>
                    </Button.Content>
                </Button>
            </Grid>
        </Expander>
        
        <TabControl Grid.Row="1">
            <TabItem Header="Конструктор">
                <Grid Width="auto">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Questions}" HorizontalAlignment="Center" AlternationCount="500">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                      Path=(ItemsControl.AlternationIndex),
                                                      Converter={StaticResource IndexPlusOneConverter}}"
                                            Command="{Binding DataContext.SelectQuestionCommand, 
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource QuestItemButton}"
                                            Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                          Path=DataContext.SelectedQuestion.IsSelected,
                                                          Mode=OneWay}">
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="0" 
                Grid.RowSpan="2"
                Visibility="{Binding HasQuestions, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                Background="{StaticResource White}"
                CornerRadius="8"
                Margin="20">
                        <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                            <TextBlock Text="📋" 
                           FontSize="72" 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource DarkSwamp}"
                           Opacity="0.5"/>
                            <TextBlock Text="Сейчас тут пусто" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{StaticResource DarkSwamp}"
                           Opacity="0.6"
                           Margin="0 20 0 10"
                           HorizontalAlignment="Center"/>
                            <TextBlock Text="Добавьте первый вопрос, нажав кнопку &quot;Добавить вопрос&quot;" 
                           FontSize="14"
                           Foreground="{StaticResource DarkSwamp}"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid HorizontalAlignment="Center">
                            <ContentControl Content="{Binding SelectedQuestion}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Border Margin="10"
                            Padding="15"
                            Style="{StaticResource CardQuestsBorderStyle}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="{StaticResource White}"
                            BorderBrush="{StaticResource DarkSwamp}"
                            MinWidth="1100"
                            MaxWidth="1100">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                
                                                <StackPanel Grid.Row="0" 
                                                      Grid.ColumnSpan="2" 
                                                      Orientation="Horizontal" 
                                                      >
                                                    <TextBlock Text="{Binding NewQuestion.NumberActual}"
                                                         FontSize="24"
                                                         FontWeight="Bold"
                                                         Foreground="{StaticResource DarkSwamp}"/>

                                                    <Button Content="✕"
                                                          Style="{StaticResource CuratorCreateTestsButton}"
                                                          Command="{Binding DataContext.RemoveQuestionCommand, 
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"
                                                          Margin="10 0 0 0"
                                                            HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Visibility="{Binding IsQuestionType, Converter={StaticResource QuestionTypeVisibilityConverter}, ConverterParameter=Options}">
                                                    <CheckBox Content="Размешать" 
                                                             IsChecked="{Binding IsRandom}"
                                                             VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBox Grid.Row="1" 
                                                   Grid.ColumnSpan="2"
                                                         Height="40"
                                                   Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                   Style="{DynamicResource TBoxStyle}"
                                                   mah:TextBoxHelper.Watermark="Текст вопроса"
                                                   Margin="0 0 0 15"/>

                                                <Grid Grid.Row="2" Visibility="{Binding IsQuestionType, Converter={StaticResource QuestionTypeVisibilityConverter}, ConverterParameter=Options}">
                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource CardQuestsBorderStyle}"
                                                                  Margin="15"
                                                                  Width="230"
                                                                  Height="230">
                                                                    <Grid>
                                                                        <Grid Visibility="{Binding IsImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="4*"/>
                                                                                <RowDefinition Height="2"/>
                                                                                <RowDefinition Height="*"/>
                                                                            </Grid.RowDefinitions>

                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                               mah:TextBoxHelper.Watermark="Текст ответа"
                                                                               Style="{StaticResource TBoxStyle}" Margin="5" FontSize="16"
                                                                               BorderThickness="0"
                                                                                  TextAlignment="Left"
                                                                                  VerticalContentAlignment="Top"/>

                                                                            <Border Grid.Row="1" BorderBrush="{StaticResource DarkSwamp}" BorderThickness="2"/>

                                                                            <Grid Grid.Row="2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <CheckBox Content="Правильный" 
                                                                                    IsChecked="{Binding IsCorrect}"
                                                                                    Margin="4 0"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Center"/>

                                                                                <Button Grid.Column="1"
                                                                                  Content="✕" 
                                                                                  Padding="0" 
                                                                                  Style="{StaticResource CuratorCreateTestsButton}"
                                                                                  Command="{Binding DeleteCommand}"
                                                                                  HorizontalAlignment="Right"
                                                                                  VerticalAlignment="Center"
                                                                                  Width="30"
                                                                                  Height="30"/>
                                                                            </Grid>
                                                                        </Grid>

                                                                        <Grid Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="4*"/>
                                                                                <RowDefinition Height="2"/>
                                                                                <RowDefinition Height="*"/>
                                                                            </Grid.RowDefinitions>

                                                                            <Grid>
                                                                                <Image Source="{Binding AbsoluteImagePath, Converter={StaticResource NullImageConverter}}"
                                                                                 VerticalAlignment="Stretch"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 Stretch="UniformToFill">
                                                                                </Image>
                                                                            </Grid>

                                                                            <Border Grid.Row="1" BorderBrush="{StaticResource DarkSwamp}" BorderThickness="2"/>

                                                                            <Grid Grid.Row="2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <CheckBox Content="Правильный" 
                                                                                    IsChecked="{Binding IsCorrect}"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="4 0"/>

                                                                                <StackPanel Grid.Column="1" 
                                                                                      Orientation="Horizontal"
                                                                                      HorizontalAlignment="Right">
                                                                                    <Button Content="✕" 
                                                                                      Padding="0"
                                                                                      Style="{StaticResource CuratorCreateTestsButton}"
                                                                                      Command="{Binding DeleteCommand}"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Width="30"
                                                                                      Height="30"
                                                                                      Margin="0 0 5 0"/>

                                                                                    <Button Content="🔍" 
                                                                                      Padding="0"
                                                                                      Style="{StaticResource CuratorCreateTestsButton}"
                                                                                      Command="{Binding ShowFullScreenImageCommand}"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Width="30"
                                                                                      Height="30"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>

                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Visibility="{Binding IsQuestionType,  Converter={StaticResource QuestionTypeVisibilityConverter},  ConverterParameter=Text}">
                                                    <Border Background="{StaticResource LightSwamp}"
                                                  BorderBrush="{StaticResource MainSwamp}"
                                                  Width="450"
                                                  Height="150"
                                                  BorderThickness="2"
                                                  CornerRadius="8"
                                                  Padding="10" Margin="20">
                                                        <TextBlock Text="Вопрос с текстовым ответом&#x0a;(тестируемый вводит ответ самостоятельно)"
                                                         TextAlignment="Center"
                                                             VerticalAlignment="Center"
                                                         FontSize="16"
                                                         Foreground="{StaticResource DarkSwamp}"/>
                                                    </Border>

                                                    <Border Background="{StaticResource LightSwamp}"
                                                  BorderBrush="{StaticResource MainSwamp}"
                                                  Width="450"
                                                  Height="150"
                                                  BorderThickness="2"
                                                  CornerRadius="8"
                                                  Padding="5" Margin="20">
                                                        <TextBox mah:TextBoxHelper.Watermark="Правильный ответ (при проверке регистр не будет учитываться)..."
                                                           Text="{Binding CorrectAnswerForTextAnswerType}" HorizontalAlignment="Stretch"
                                                           Style="{StaticResource TBoxStyle}"
                                                           BorderThickness="0"
                                                           TextAlignment="Left"
                                                           VerticalContentAlignment="Top"
                                                           VerticalAlignment="Stretch"
                       
                     
                                                         FontSize="16"
                                                         Foreground="{StaticResource DarkSwamp}"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0" Visibility="{Binding IsQuestionType, Converter={StaticResource QuestionTypeVisibilityConverter},  ConverterParameter=Options}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Основное изображение:" 
                                                             Style="{StaticResource Hint}" 
                                                             Margin="0" 
                                                             TextWrapping="Wrap"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1" 
                                                              HorizontalAlignment="Right" 
                                                              Orientation="Horizontal">
                                                            <Button Content="✕" 
                                                              Padding="0" 
                                                              Margin="0 0 5 0"
                                                              Style="{StaticResource CuratorCreateTestsButton}"
                                                              Command="{Binding DeleteMainImageCommand}"
                                                              Visibility="{Binding PreviewImagePath, Converter={StaticResource StringToVisibility}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Width="30"
                                                              Height="30"/>
                                                            <Button Content="🔍" 
                                                              Padding="0" 
                                                              Margin="0 0 5 0"
                                                              Style="{StaticResource CuratorCreateTestsButton}"
                                                              Command="{Binding ShowFullScreenImageCommand}"
                                                              Visibility="{Binding PreviewImagePath, Converter={StaticResource StringToVisibility}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Width="30"
                                                              Height="30"/>
                                                            <TextBlock Text="отсутствует" Visibility="{Binding PreviewImagePath, Converter={StaticResource InverseStringToVisibilityConverter}}"
                                                             Style="{StaticResource Hint2}" 
                                                             Margin="0" 
                                                             TextWrapping="Wrap"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Style="{StaticResource BackgroundDarkSwamp}"
                                                      BorderBrush="{StaticResource DarkSwamp}" 
                                                      BorderThickness="2" 
                                                      CornerRadius="4" 
                                                      Margin="0" 
                                                      Padding="0">

                                                        <Button Tag="{Binding}"
                                                          Command="{Binding SetQuestionImageCommand}"
                                                          Background="Transparent"
                                                          BorderThickness="0" 
                                                          Width="200" 
                                                          Height="200" 
                                                          Margin="0" 
                                                          Padding="0">
                                                            <Image Stretch="UniformToFill" Margin="0">
                                                                <Image.Source>
                                                                    <PriorityBinding>
                                                                        <Binding Path="PreviewImagePath" 
                                                                           Converter="{StaticResource NullImageConverter}"/>
                                                                        <Binding Source="pack://application:,,,/Images/add_picture_icon_2.png"/>
                                                                    </PriorityBinding>
                                                                </Image.Source>
                                                            </Image>
                                                        </Button>
                                                    </Border>

                                                    <StackPanel Orientation="Vertical" 
                                                          HorizontalAlignment="Center"
                                                          Margin="0 10 0 0">

                                                        <Button Content="+ Текст"
                                                          Command="{Binding AddTextOptionCommand}"
                                                          Tag="{Binding}"
                                                          Style="{StaticResource ConfirmButton}"
                                                          Width="200"
                                                          Margin="0 5"/>
                                                        <Button Content="+ Фото"
                                                          Command="{Binding AddImageOptionCommand}"
                                                          Tag="{Binding}"
                                                          Style="{StaticResource ConfirmButton}"
                                                          Width="200"
                                                          Margin="0 5"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Row="2" Grid.Column="0" Margin="0" Visibility="{Binding IsQuestionType, Converter={StaticResource QuestionTypeVisibilityConverter}, ConverterParameter=Compliance}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="2"/>
                                                        <ColumnDefinition Width="3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="5">
                                                        <ItemsControl ItemsSource="{Binding ConstantOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="2">
                                                                        <TextBlock Text="{Binding NewOption.Number}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                        <TextBox Style="{StaticResource TBoxStyle}" Height="40" 
                                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                                                 Width="150"/>
                                                                        <Button Style="{StaticResource QuestItemButton}" Content="×" 
                                                                                Command="{Binding DataContext.RemoveConstantOptionCommand, 
                                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}" Margin="5,0,0,0"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Content="Добавить" Command="{Binding AddConstantOptionCommand}" Margin="5" Style="{StaticResource ConfirmButton}"/>

                                                    <TextBlock Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="5">
                                                        <ItemsControl ItemsSource="{Binding CorrespondingOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="2">
                                                                        <TextBlock Text="{Binding NewOption.Number}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                        <ComboBox Width="150" Height="40" 
                                                                                  ItemsSource="{Binding DataContext.Options, 
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                  SelectedItem="{Binding SelectedMatch}"
                                                                                  DisplayMemberPath="Value"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Separator Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10"/>

                                                    <StackPanel Grid.Column="4" Grid.Row="0" Margin="5">
                                                        <TextBlock Text="Варианты ответов:" FontWeight="Bold" Margin="5"/>

                                                        <ItemsControl ItemsSource="{Binding Options}"
                                                                      MinHeight="10">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="2">
                                                                        <TextBox Style="{StaticResource TBoxStyle}" Height="40" 
                                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                                                 Width="150"/>
                                                                        <Button Style="{StaticResource QuestItemButton}" Content="×" 
                                                                                Command="{Binding DeleteCommand}"
                                                                                Margin="5,0,0,0"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Button Grid.Column="4" Grid.Row="1" VerticalAlignment="Bottom" Content="Добавить" Command="{Binding AddComplianceOptionCommand}" Margin="5" HorizontalAlignment="Left" Style="{StaticResource ConfirmButton}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Лента" Width="Auto">
                <Grid Width="1400">
                    <!--Лента-->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" 
                          MaxHeight="1000">
                        <StackPanel Margin="20">

                            <ItemsControl ItemsSource="{Binding Questions}"
                                  AlternationCount="500">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0 10"
                                        Padding="15"
                                        Style="{StaticResource CardQuestsBorderStyle}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Background="{StaticResource White}"
                                        MaxWidth="1100">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4*"/>
