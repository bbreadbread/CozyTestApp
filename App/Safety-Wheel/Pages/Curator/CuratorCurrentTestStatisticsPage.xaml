<UserControl x:Class="CozyTest.Pages.Curator.CuratorCurrentTestStatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CozyTest.Pages.Curator"
             mc:Ignorable="d" 
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:vm="clr-namespace:CozyTest.ViewModels.CuratorVM.StatisticsVM"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CozyTest.Converters"
             Background="#FFFFFF">

    <UserControl.Resources>
        <converters:PercentageToWidthConverter  x:Key="PercentageToWidthConverter"/>
        
        <Style x:Key="QuestionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="HorizontalBarStyle" TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#E8F0FE"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="24,24,24,48">

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{Binding CurrentTest.Name}" 
                           FontSize="32" 
                           FontWeight="Light" 
                           Foreground="#202124"
                           Margin="0,0,0,16"/>

                <Border Background="White" 
                        BorderBrush="#DADCE0"
                        BorderThickness="1"
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Все участники"
                                  materialDesign:TextFieldAssist.UnderlineBrush="#1A73E8"
                                  ItemsSource="{Binding Participants}"
                                  SelectedItem="{Binding SelectedParticipant}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,16,0"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                        <Button Grid.Column="1" 
                                Command="{Binding ClearFilterCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Сбросить фильтр"
                                >
                            <materialDesign:PackIcon Kind="FilterOff" Foreground="#5F6368"/>
                        </Button>

                        <Button Grid.Column="2" 
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Обновить">
                            <materialDesign:PackIcon Kind="Refresh" Foreground="#5F6368"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding TotalResponses, StringFormat='{}{0} ответов'}" 
                       FontSize="24" 
                       FontWeight="Medium" 
                       Foreground="#202124"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Средний" 
                               FontSize="14" 
                               Foreground="#5F6368"/>
                    <TextBlock  FontSize="16" 
                                Foreground="#202124"
                                Margin="0,4,0,0">
                        <Run Text="{Binding AverageScore}"/>
                        <Run Text=" из "/>
                        <Run Text="{Binding CountQuest}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Медиана" 
                               FontSize="14" 
                               Foreground="#5F6368"/>
                    <TextBlock  FontSize="16" 
                               Foreground="#202124"
                               Margin="0,4,0,0">
                        <Run Text="{Binding MedianScore}"/>
                        <Run Text=" из "/>
                        <Run Text="{Binding CountQuest}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Диапазон" 
                               FontSize="14" 
                               Foreground="#5F6368"/>
                    <TextBlock  FontSize="16" 
                                Foreground="#202124"
                                Margin="0,4,0,0">
                         <Run Text="{Binding MinScore}"/>
                         <Run Text=" из "/>
                         <Run Text="{Binding CountQuest}"/>
                    </TextBlock>
                    
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource QuestionCardStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Распределение баллов" 
                               FontSize="18" 
                               FontWeight="Medium" 
                               Foreground="#202124"
                               Margin="0,0,0,16"/>

                    <scottPlot:WpfPlot Grid.Row="1" 
                                       x:Name="ScoreDistributionPlot"
                                       Loaded="ScoreDistributionPlot_Loaded"/>
                </Grid>
            </Border>

            <TextBlock Text="Вопросы, на которые часто даются неправильные ответы" 
                       FontSize="18" 
                       FontWeight="Medium" 
                       Foreground="#202124"
                       Margin="0,0,0,16"/>

            <Border BorderBrush="#DADCE0" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,24">
                <DataGrid ItemsSource="{Binding QuestionsWrong}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Вопрос" 
                                            Binding="{Binding QuestionText}" 
                                            Width="*"
                                            FontSize="14"/>
                        <DataGridTextColumn Header="Правильные ответы" 
                                            Binding="{Binding RatioText}" 
                                            Width="Auto"
                                            FontSize="14"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ItemsControl ItemsSource="{Binding QuestionDetails}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource QuestionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding QuestionText}" 
                                           FontSize="16" 
                                           FontWeight="Medium" 
                                           Foreground="#202124"
                                           TextWrapping="Wrap"
                                           Margin="0 0 0 8"/>

                                <TextBlock Text="{Binding CorrectRatioText}" 
                                           FontSize="14" 
                                           Foreground="#5F6368"
                                           Margin="0 0 0 16"/>

                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0 0 0 8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" 
                                                            Orientation="Horizontal"
                                                            Margin="10 0 0 4">
                                                    <TextBlock Text="✓ " 
                                                               Foreground="#34A853"
                                                               FontWeight="Bold"
                                                               Visibility="{Binding IsCorrect, 
                                                                   Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding Text}" 
                                                               FontSize="14" 
                                                               Foreground="#202124"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Grid Grid.Row="1" HorizontalAlignment="Stretch" Margin="10 0 0 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="700"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Height="20"
                                                            CornerRadius="4"
                                                            Background="{StaticResource LightSwamp}"
                                                            BorderBrush="{StaticResource MainSwamp}"
                                                            BorderThickness="1"
                                                            Margin="0,0,8,0">
                                                        <Border Background="{StaticResource MainSwamp}"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding Percentage, 
                                                                    Converter={StaticResource PercentageToWidthConverter},
                                                                    ConverterParameter=700}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding CountText}" 
                                                               FontSize="12" 
                                                               Foreground="#5F6368"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <Expander Grid.Row="2" 
                                                          Header="Иные ответы участников" 
                                                          Padding="10"
                                                          HorizontalAlignment="Stretch"
                                                          Background="Transparent"
                                                          Margin="0 10 0 0"
                                                          BorderBrush="{StaticResource MainSwamp}"
                                                          BorderThickness="1"
                                                          Visibility="{Binding QuestionOpt.QuestionTypeId, 
                                                              Converter={StaticResource QuestionTypeVisibilityConverter}, 
                                                              ConverterParameter=Text}">
                                                    <ItemsControl ItemsSource="{Binding OtherAnswers}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0 8 0 0">
                                                                    <TextBlock Text="{Binding Text}" 
                                                                               FontSize="14" 
                                                                               Margin="0 0 0 5"
                                                                               Foreground="#202124"
                                                                               TextWrapping="Wrap"/>

                                                                    <Grid HorizontalAlignment="Stretch">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="700"/>
                                                                            <ColumnDefinition Width="60"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Column="0"
                                                                                Height="20"
                                                                                CornerRadius="4"
                                                                                Background="{StaticResource LightSwamp}"
                                                                                BorderBrush="{StaticResource MainSwamp}"
                                                                                BorderThickness="1"
                                                                                Margin="0 0 8 0">
                                                                            <Border Background="{StaticResource MainSwamp}"
                                                                                    CornerRadius="4"
                                                                                    HorizontalAlignment="Left"
                                                                                    Width="{Binding Percentage, 
                                                                                         Converter={StaticResource PercentageToWidthConverter},
                                                                                         ConverterParameter=700}"/>
                                                                        </Border>

                                                                        <TextBlock Grid.Column="1" 
                                                                                   Text="{Binding CountText}" 
                                                                                   FontSize="12" 
                                                                                   Foreground="#5F6368"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Pairs}"
                                              Visibility="{Binding QuestionTypeId, 
                                                  Converter={StaticResource QuestionTypeVisibilityConverter}, 
                                                  ConverterParameter=Compliance}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" 
                                                            Orientation="Horizontal"
                                                            Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding CorrectIndicator}" 
                                                               FontWeight="Bold"
                                                               Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding FullPairText}" 
                                                               FontSize="14" 
                                                               Foreground="#202124"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Height="20"
                                                            CornerRadius="4"
                                                            Background="#78A9A9"
                                                            Margin="0,0,8,0">
                                                        <Border 
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding Percentage, 
                                                                    Converter={StaticResource PercentageToWidthConverter},
                                                                    ConverterParameter=700}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding CountText}" 
                                                               FontSize="12" 
                                                               Foreground="#5F6368"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--<Border Background="White" 
                    BorderBrush="#DADCE0"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="48" 
                    Margin="0,24,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBar" 
                                             Width="64" 
                                             Height="64" 
                                             Foreground="#DADCE0"/>
                    <TextBlock Text="Нет данных для отображения" 
                               FontSize="16" 
                               Foreground="#5F6368" 
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Border>-->

        </StackPanel>
    </ScrollViewer>
</UserControl>