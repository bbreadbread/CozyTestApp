<UserControl x:Class="CozyTest.Pages.Participant.AuthorizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"        
             mc:Ignorable="d" 
             d:DesignHeight="700" 
             d:DesignWidth="1000"
             Background="{StaticResource LightSwamp}">

    <Viewbox MaxWidth="900"
             MaxHeight="600"
             MinWidth="500"
             MinHeight="400">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="40">

                <Border Background="White"
                        CornerRadius="20"
                        BorderBrush="{StaticResource PaleSwamp}"
                        BorderThickness="2"
                        Padding="50 40"
                        MinWidth="700">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Авторизация"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkSwamp}"
                                   HorizontalAlignment="Center"
                                   Margin="10 20"/>

                        <Grid Grid.Row="3" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Логин"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MainSwamp}"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    Background="White"
                                    BorderBrush="{StaticResource PaleSwamp}"
                                    Padding="2">
                                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Login"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Center"
                                         FontWeight="Medium"
                                         FontSize="22"
                                         mah:TextBoxHelper.ClearTextButton="True"
                                         Padding="12,10"
                                         CaretBrush="{StaticResource MainSwamp}"
                                         Foreground="{StaticResource DarkSwamp}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Пароль"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MainSwamp}"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    Background="White"
                                    BorderBrush="{StaticResource PaleSwamp}"
                                    Padding="2">
                                <PasswordBox x:Name="TbPassword"
                                             AutomationProperties.Name="Password"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalAlignment="Center"
                                             FontWeight="Medium"
                                             FontSize="22"
                                             Padding="12,10"
                                             CaretBrush="{StaticResource MainSwamp}"
                                             Foreground="{StaticResource DarkSwamp}"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Border>
                        </Grid>

                        <Button Grid.Row="5"
                                Command="{Binding AuthCommand}"
                                Margin="0,0,0,20"
                                Height="55"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource MainSwamp}"/>
                                    <Setter Property="Foreground" Value="{StaticResource LightSwamp}"/>
                                    <Setter Property="FontSize" Value="22"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverSwamp}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Войти"/>
                        </Button>

                        <Button Grid.Row="6"
                                Command="{Binding RequestAccountCommand}"
                                Height="50"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource MainSwamp}"/>
                                    <Setter Property="FontSize" Value="18"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource MainSwamp}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PaleSwamp}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DarkSwamp}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Отправить заявку на создание аккаунта"/>
                        </Button>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Viewbox>
</UserControl>