<UserControl x:Class="CozyTest.Pages.Participant.PartProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:local="clr-namespace:CozyTest.Pages.Participant"
      xmlns:conv="clr-namespace:CozyTest.Converters">
    
    <UserControl.Resources>
            <conv:DateHasAssignmentConverter x:Key="DateHasAssignmentConverter"/>
        </UserControl.Resources>

    <Grid MaxWidth="1500">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="10" Style="{StaticResource CardBorderSimpleStyle}" Height="130">
            <StackPanel Margin="20" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource MainWelcomeTB}">
                    <Run Text="{Binding AccNameText}" FontWeight="SemiBold"/>
                    <Border Width="2" Height="20" Background="Black" Margin="15 0"/>
                    <Run Text="{Binding AccLoginText}" FontWeight="SemiBold"/>
                    <Border Width="2" Height="20" Background="Black" Margin="15 0"/>
                    <Run Text="{Binding CreatorNameText}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="0" Grid.Row="1">
            <Border Margin="10" Style="{StaticResource CardBorderSimpleStyle}" Height="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Назначенные даты" Style="{StaticResource MainWelcomeTB}" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Calendar
                                Name="AssignmentCalendar"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                DisplayDate="{Binding SelectedDate, Mode=TwoWay}"
                                SelectionMode="SingleDate"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="210"
                                Height="310" Grid.RowSpan="2">
                            <Calendar.CalendarDayButtonStyle>
                                <Style TargetType="CalendarDayButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" Value="{x:Null}">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>

                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource DateHasAssignmentConverter}">
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                                                    <Binding Path="DataContext.DatesWithAssignments" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="LightGreen"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Calendar.CalendarDayButtonStyle>
                        </Calendar>

                        <GroupBox Header="Назначенные тесты на выбранную дату" Grid.Column="1" Margin="6 4 4 4" Padding="0">
                            <ListView 
                                        ItemsSource="{Binding AssignmentsOnSelectedDate}"
                                        SelectedItem="{Binding SelectedAssignedTest}"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="10">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding TestId}"/>
                                        <GridViewColumn Header="Название теста" DisplayMemberBinding="{Binding Test.Name}"/>
                                        <GridViewColumn Header="Дата назначения" DisplayMemberBinding="{Binding DateTimeAssigned, StringFormat=\{0:dd.MM.yyyy\}}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>

                        <Button Grid.Column="1" Grid.Row="1" Content="Перейти к выбранному тесту" Command="{Binding GoToAssignedTestsCommand}" Margin="6 4 4 4"/>
                    </Grid>

                    
                </StackPanel>
            </Border>

            <Border Margin="10" Style="{StaticResource CardBorderSimpleStyle}" Height="Auto">
                <StackPanel Margin="20">
                    <TextBlock Margin="0 0 0 10" Style="{StaticResource MainWelcomeTB}" HorizontalAlignment="Left">
                        <Run Text="Всего пройдено опросов: " FontWeight="SemiBold"/>
                        <Run Text="{Binding TotalQuizzesPassed}"/>
                    </TextBlock>

                    <TextBlock Margin="0 0 0 10" Style="{StaticResource MainWelcomeTB}" HorizontalAlignment="Left">
                        <Run Text="Всего пройдено тестов: " FontWeight="SemiBold"/>
                        <Run Text="{Binding TotalTestsPassed}"/>
                    </TextBlock>

                    <TextBlock Margin="0 0 0 10" Style="{StaticResource MainWelcomeTB}" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Большего всего попыток у теста:  " HorizontalAlignment="Left" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TestWithMostAttempts}" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                        </StackPanel>
                    </TextBlock>
                    <Button Content="Посмотреть все свои прохождения" Command="{Binding GoToAllAttemptsCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1">
            <Border Margin="10" Style="{StaticResource CardBorderSimpleStyle}" Height="Auto">
                <StackPanel Margin="15">
                    <TextBlock Text="Кураторы, за которыми вы закреплены" 
                               TextWrapping="Wrap" 
                               Style="{StaticResource MainWelcomeTB}" 
                               HorizontalAlignment="Left"  
                               FontWeight="SemiBold"
                               Margin="0 0 0 10"/>

                    <DataGrid ItemsSource="{Binding CuratorsList}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              MaxHeight="200"
                              Margin="0 0 0 20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="50"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="ФИО куратора" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Login}" Header="Логин" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Группы, в которых вы состоите" 
                               TextWrapping="Wrap" 
                               Style="{StaticResource MainWelcomeTB}" 
                               HorizontalAlignment="Left"  
                               FontWeight="SemiBold"
                               Margin="0 0 0 10"/>

                    <DataGrid ItemsSource="{Binding GroupsList}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id}" Header="ID группы" Width="80"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="Название группы" Width="*"/>
                            <DataGridTextColumn Binding="{Binding CountPart}" Header="Кол-во участников" Width="150"/>
                            <DataGridTextColumn Binding="{Binding Description}" Header="Описание" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.RowSpan="5" Grid.ColumnSpan="5"
        Background="#2000685A" 
        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"  
                     IsIndeterminate="True" 
                     Foreground="{StaticResource MainSwamp}"
                     Width="50" 
                     Height="50"/>
                <TextBlock Text="Загрузка..." Margin="0 10 0 0" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>