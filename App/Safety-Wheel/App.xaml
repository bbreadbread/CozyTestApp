<Application x:Class="CozyTest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:notifications="clr-namespace:Notifications.Wpf.Controls;assembly=Notifications.Wpf"
             xmlns:local="clr-namespace:CozyTest"
             xmlns:converters="clr-namespace:CozyTest.Converters">
    <Application.Resources>

        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <converters:InverseBoolToOpacityConverter x:Key="InverseBoolToOpacityConverter"/>
            <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter"/>
            <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
            <converters:BoolToIntConverter x:Key="BoolToIntConverter"/>
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:QuestionTypeVisibilityConverter x:Key="QuestionTypeVisibilityConverter"/>
            <converters:CardWidthConverter x:Key="CardWidthConverter"/>
            <converters:CardMarginConverter x:Key="CardMarginConverter"/>
            <converters:DateHasAssignmentConverter x:Key="DateHasAssignmentConverter"/>
            <converters:IndexPlusOneConverter x:Key="IndexPlusOneConverter"/>
            <converters:NullImageConverter x:Key="NullImageConverter"/>
            <converters:MenuTypeToSingleVisibilityConverter x:Key="MenuTypeToSingleVisibilityConverter"/>
            <converters:QuestionToTagConverter x:Key="QuestionToTagConverter"/>
            <converters:MarkLvlToColorConverter x:Key="MarkLvlToColorConverter"/>
            <converters:StringToColorConverter x:Key="StringToColorConverter"/>
            <converters:PercentageToWidthConverter  x:Key="PercentageToWidthConverter"/>
            <converters:RoleLogsConverter  x:Key="RoleLogsConverter"/>


            <converters:RoleVisibilityConverter x:Key="RoleVisibilityConverter"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
            <converters:EnabledConverter x:Key="EnabledConverter"/>
            <converters:RequestCountConverter x:Key="RequestCountConverter"/>
            <converters:PasswordEditVisibilityConverter x:Key="PasswordEditVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:RoleDisplayConverter x:Key="RoleDisplayConverter"/>
            <converters:InstanceOfTypeToVisibilityConverter x:Key="InstanceOfTypeToVisibilityConverter"/>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />

                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Teal"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <ResourceDictionary Source="/Styles/Color/Default.xaml"/>
                <ResourceDictionary Source="/Styles/UI/Main.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
